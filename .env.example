DATABASE_URL=postgresql://plant:plant@127.0.0.1:5432/plantcare
LLM_BACKEND=cc            # cc = claude -p on the Max plan (default) | api = Anthropic SDK (Act 2 benchmark only)
ANTHROPIC_API_KEY=        # only if LLM_BACKEND=api
EMBED_MODEL=BAAI/bge-base-en-v1.5
# API_KEY=                # set: /ask requires "Authorization: Bearer <key>"; unset: /ask is open (startup warns). No '#' in the key.
# MAX_INFLIGHT=           # concurrent /ask generations before 503 busy + Retry-After (default 4)
